/* Perspective v2. Bound to the existing spreadsheet. No credentials in source. */
var V2_POSTS='PostsV2', V2_METRICS='MeasurementsV2', V2_OPS='OperationsV2';
var METRIC_KEYS=['impressions','reactions','comments','members_reached','reposts','saves','sends','articles_read','email_open_pct'];
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function ss_(){return SpreadsheetApp.getActiveSpreadsheet();}
function table_(name){var s=ss_().getSheetByName(name);if(!s){s=ss_().insertSheet(name);s.appendRow(['id','revision','json']);s.setFrozenRows(1);}return s;}
function rows_(name){var s=table_(name);return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,3).getValues().map(function(r){return JSON.parse(r[2]);});}
function put_(name,id,value){var s=table_(name),ids=s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,1).getValues().map(function(r){return r[0];}):[];var i=ids.indexOf(id),data=JSON.stringify(value);if(data.length>45000)throw Error('Entry is too long.');s.getRange(i<0?s.getLastRow()+1:i+2,1,1,3).setValues([[id,value.revision||1,data]]);}
function doGet(){return json_({ok:true,apiVersion:2,service:'Perspective',authenticated:false});}
function doPost(e){var lock=LockService.getScriptLock();try{var body=JSON.parse(e.postData.contents);var key=PropertiesService.getScriptProperties().getProperty('PERSPECTIVE_ACCESS_KEY');if(key&&body.accessKey!==key)return json_({ok:false,code:'AUTH',error:'Enter your private access key in Settings.'});if(body.apiVersion!==2)throw Error('Please update the app.');lock.waitLock(20000);rows_(V2_OPS).filter(function(o){return o.status==='prepared';}).forEach(apply_);if(body.action==='bootstrap')return json_({ok:true,posts:rows_(V2_POSTS),measurements:rows_(V2_METRICS),serverTime:new Date().toISOString()});if(body.action==='history')return json_({ok:true,operations:rows_(V2_OPS).filter(function(o){return o.post_id===body.postId;}).map(function(o){return {action:o.action,time:o.time,before:o.before,after:o.after};})});if(!/^[a-zA-Z0-9-]{10,80}$/.test(body.requestId||''))throw Error('Invalid request ID.');var old=rows_(V2_OPS).filter(function(o){return o.request_id===body.requestId;})[0];if(old){if(old.status==='prepared')apply_(old);return json_({ok:true,requestId:body.requestId,replayed:true});}var op=prepare_(body);put_(V2_OPS,body.requestId,op);apply_(op);return json_({ok:true,requestId:body.requestId});}catch(err){return json_({ok:false,code:/conflict/i.test(err.message)?'CONFLICT':'INVALID',error:err.message});}finally{if(lock.hasLock())lock.releaseLock();}}
function cleanPost_(p){var o={},allowed=['post_id','published_date_local','published_at_utc','original_url','post_text','format','with_image','hook_category','hook_source','topic_tags','notes','article_url','primary_measurement_id','archived_at','legacy_source_row'];allowed.forEach(function(k){if(p[k]!==undefined)o[k]=p[k];});if(!/^\d{4}-\d{2}-\d{2}$/.test(o.published_date_local||'')||isNaN(Date.parse(o.published_date_local+'T12:00:00Z')))throw Error('A valid post date is required.');if(o.original_url&&!/^https:\/\/(?:www\.)?(?:linkedin\.com|lnkd\.in)\//i.test(o.original_url))throw Error('Invalid LinkedIn URL.');if(new Date(o.published_date_local+'T12:00:00Z').toISOString().slice(0,10)!==o.published_date_local)throw Error('Invalid calendar date.');if(o.published_at_utc&&isNaN(Date.parse(o.published_at_utc)))throw Error('Invalid publication time.');if(['Post','Carousel','Article','Video'].indexOf(o.format)<0)throw Error('Choose a valid format.');if(!Array.isArray(o.topic_tags))o.topic_tags=[];o.topic_tags=o.topic_tags.slice(0,12).map(String);if(String(o.post_text||'').length>20000||String(o.notes||'').length>5000)throw Error('Text exceeds the entry limit.');return o;}
function cleanMetric_(m){var o={};['measurement_id','post_id','captured_at_utc','capture_time_quality','source','legacy_zero_ambiguity','approximate_fields'].forEach(function(k){if(m[k]!==undefined)o[k]=m[k];});METRIC_KEYS.forEach(function(k){var v=m[k];if(v===null||v===''||v===undefined)o[k]=null;else{v=Number(v);if(!isFinite(v)||v<0||(k!=='email_open_pct'&&!Number.isSafeInteger(v))||(k==='email_open_pct'&&v>100))throw Error('Invalid '+k);o[k]=v;}});if(o.captured_at_utc&&isNaN(Date.parse(o.captured_at_utc)))throw Error('Invalid capture time.');return o;}
function prepare_(b){var now=new Date().toISOString(),posts=rows_(V2_POSTS),ms=rows_(V2_METRICS),p=posts.filter(function(p){return p.post_id===b.post.post_id;})[0],m=b.measurement&&ms.filter(function(m){return m.measurement_id===b.measurement.measurement_id;})[0];if(p&&p.revision!==b.baseRevision)throw Error('Edit conflict: another device changed this post. Reload and review.');if(m&&m.revision!==b.measurementRevision)throw Error('Edit conflict: this measurement has changed.');if(['save','archive','restore'].indexOf(b.action)<0)throw Error('Unsupported operation.');var after=cleanPost_(b.post);if(!/^[a-zA-Z0-9-]{10,80}$/.test(after.post_id||''))throw Error('Invalid post ID.');after.revision=(p?p.revision:0)+1;after.created_at=p?p.created_at:now;after.updated_at=now;if(b.action==='archive')after.archived_at=now;if(b.action==='restore')after.archived_at=null;var metric=b.measurement?cleanMetric_(b.measurement):null;if(metric){if(!/^[a-zA-Z0-9-]{10,80}$/.test(metric.measurement_id||''))throw Error('Invalid measurement ID.');if(m&&m.post_id!==after.post_id)throw Error('Measurement belongs to another post.');metric.post_id=after.post_id;metric.revision=(m?m.revision:0)+1;metric.logged_at_utc=m?m.logged_at_utc:now;metric.updated_at=now;}if(after.original_url&&posts.some(function(x){return x.post_id!==after.post_id&&x.original_url===after.original_url;}))throw Error('This link belongs to another post.');var primary=after.primary_measurement_id;if(primary&&!(metric&&metric.measurement_id===primary)&&!ms.some(function(x){return x.measurement_id===primary&&x.post_id===after.post_id;}))throw Error('Invalid primary measurement.');return {request_id:b.requestId,post_id:after.post_id,action:b.action,status:'prepared',time:now,before:{post:p||null,measurement:m||null},after:{post:after,measurement:metric}};}
function apply_(op){put_(V2_POSTS,op.post_id,op.after.post);if(op.after.measurement)put_(V2_METRICS,op.after.measurement.measurement_id,op.after.measurement);SpreadsheetApp.flush();op.status='committed';put_(V2_OPS,op.request_id,op);}
/* Run in the editor first: inspect summary; original Posts is never modified. */
function migrationPreview(){var s=ss_().getSheetByName('Posts'),v=s.getDataRange().getValues();console.log(JSON.stringify({records:v.length-1,headers:v[0],destination:'PostsV2 / MeasurementsV2',originalPreserved:true}));}
function migrateLegacy(){var lock=LockService.getScriptLock();lock.waitLock(20000);try{var s=ss_().getSheetByName('Posts'),all=s.getDataRange().getValues(),h=all.shift(),existing=rows_(V2_POSTS),count=0;all.forEach(function(r,i){var id='legacy-post-'+(i+2);if(existing.some(function(p){return p.post_id===id;}))return;var x={};h.forEach(function(k,j){x[k]=r[j] instanceof Date?(k==='PostDate'?Utilities.formatDate(r[j],'Asia/Kolkata','yyyy-MM-dd'):r[j].toISOString()):r[j];});if(!x.PostDate)return;var p={post_id:id,revision:1,published_date_local:String(x.PostDate).slice(0,10),published_at_utc:null,original_url:x.PostURL||'',post_text:x.PostText||'',format:x.PostType||'Post',with_image:x.WithImage==='Yes',hook_category:x.HookType||'Uncategorized',hook_source:'manual',topic_tags:[],notes:x.Notes||'',article_url:x.ArticleURL||'',primary_measurement_id:'legacy-metric-'+(i+2),legacy_source_row:i+2,created_at:x.Timestamp,updated_at:x.Timestamp};var m={measurement_id:p.primary_measurement_id,post_id:id,revision:1,logged_at_utc:String(x.Timestamp),captured_at_utc:null,capture_time_quality:'legacy_unknown',source:'legacy_import',legacy_zero_ambiguity:true};var old=['Impressions','Reactions','Comments','MembersReached','Reposts','Saves','Sends','ArticlesRead','EmailOpenPct'];METRIC_KEYS.forEach(function(k,j){m[k]=x[old[j]]===''||x[old[j]]==null?null:Number(x[old[j]]);});put_(V2_METRICS,m.measurement_id,m);put_(V2_POSTS,id,p);count++;});console.log('Imported '+count+' records. Original Posts tab preserved.');}finally{lock.releaseLock();}}

function repairLegacyDates(){var all=ss_().getSheetByName('Posts').getDataRange().getValues(),index=all[0].indexOf('PostDate'),count=0;rows_(V2_POSTS).forEach(function(p){if(!p.legacy_source_row||p.revision!==1)return;var v=all[p.legacy_source_row-1][index],d=v instanceof Date?Utilities.formatDate(v,'Asia/Kolkata','yyyy-MM-dd'):String(v).slice(0,10);if(d!==p.published_date_local){p.published_date_local=d;put_(V2_POSTS,p.post_id,p);count++;}});console.log('Reconciled '+count+' legacy local dates against original Sheet.');}
